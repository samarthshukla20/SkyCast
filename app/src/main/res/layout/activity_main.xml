<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SkyCast"
                android:textColor="@color/sky_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/btnThemeToggle"
                android:layout_width="68dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_theme_switch_track"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Switch theme">

                <FrameLayout
                    android:id="@+id/themeToggleThumb"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_theme_switch_thumb"
                    android:elevation="3dp">

                    <TextView
                        android:id="@+id/tvThemeToggleIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="☾"
                        android:textColor="@color/sky_background"
                        android:textSize="17sp" />

                </FrameLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- City Search and Current Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etCitySearch"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_weather_card"
                android:hint="Search city..."
                android:imeOptions="actionSearch"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/sky_text_primary"
                android:textColorHint="@color/sky_text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSearchCity"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/sky_accent"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Search"
                android:textAllCaps="false"
                android:textColor="@color/sky_background" />

            <ImageButton
                android:id="@+id/btnCurrentLocation"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_weather_card"
                android:contentDescription="Use current location"
                android:padding="13dp"
                android:src="@android:drawable/ic_menu_mylocation"
                app:tint="@color/sky_accent" />
        </LinearLayout>

        <!-- City Suggestions Dropdown -->
        <LinearLayout
            android:id="@+id/citySuggestionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_weather_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/citySuggestionsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- Location -->
        <TextView
            android:id="@+id/tvCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:gravity="center"
            android:text="Finding your location..."
            android:textColor="@color/sky_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Tuesday, 3 November"
            android:textColor="@color/sky_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLastUpdated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Waiting for weather data..."
            android:textColor="@color/sky_text_secondary"
            android:textSize="11sp" />

        <!-- Dynamic Weather Animation -->
        <FrameLayout
            android:id="@+id/weatherAnimationContainer"
            android:layout_width="220dp"
            android:layout_height="190dp"
            android:layout_gravity="center"
            android:layout_marginTop="15dp">

            <!-- Weather glow -->
            <View
                android:id="@+id/weatherGlow"
                android:layout_width="310dp"
                android:layout_height="310dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent" />

            <!-- Lottie weather animation -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/tvWeatherIcon"
                android:layout_width="180dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                app:lottie_autoPlay="false"
                app:lottie_loop="true" />

        </FrameLayout>

        <!-- Temperature -->
        <TextView
            android:id="@+id/tvTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="28°"
            android:textColor="@color/sky_text_primary"
            android:textSize="76sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Clear Sky"
            android:textColor="@color/sky_accent"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/tvHighLow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="H: 31°    L: 22°"
            android:textColor="@color/sky_text_secondary"
            android:textSize="15sp" />

        <!-- Weather Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:background="@drawable/bg_weather_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFeelsLike"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Feels Like
29°C"
                    android:textColor="@color/sky_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvHumidity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Humidity
45%"
                    android:textColor="@color/sky_text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/sky_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWind"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wind
12 km/h"
                    android:textColor="@color/sky_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvPressure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pressure
1012 hPa"
                    android:textColor="@color/sky_text_primary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Forecast Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="5-Day Forecast"
            android:textColor="@color/sky_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Forecast RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/forecastRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:layout_marginTop="15dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />
    </LinearLayout>
</ScrollView>
