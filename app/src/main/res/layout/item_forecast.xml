<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="90dp"
    android:layout_height="175dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_weather_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvForecastDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textColor="@color/sky_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvForecastIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="☀"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/tvForecastMax"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="30°"
        android:textColor="@color/sky_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvForecastMin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="22°"
        android:textColor="@color/sky_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvForecastRain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Rain 0%"
        android:textColor="@color/sky_accent"
        android:textSize="10sp"
        android:visibility="visible" />

</LinearLayout>